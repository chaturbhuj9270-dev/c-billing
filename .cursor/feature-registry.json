{
  "version": 2,
  "about": "Living map of what the app must keep doing. scripts/feature_guard.py verifies every anchor still exists and every forbidden pattern is still absent. Update this file in the same change that adds, moves or intentionally changes a feature.",
  "features": [
    {
      "id": "customer-ledger",
      "name": "Customer ledger, pending amount and receive payment",
      "files": [
        "lib/features/customer/",
        "lib/core/services/customer_transaction_service.dart"
      ],
      "invariants": [
        "Ledger rows and the customer's pending amount are written ONLY through CustomerTransactionOfflineController (addBillTransaction / addPaymentTransaction / addReturnTransaction). Never also write the same event straight to Firestore (CustomerTransactionService.receivePayment / recordBillGenerated): that duplicated rows and doubled the balance.",
        "Receive Payment is hidden when pending <= 0 and the amount can never exceed pending (button gate, sheet validator, save guard).",
        "Every 'Bill Created' ledger row shows Bill Total / Received / Pending taken from the bill itself.",
        "The duplicate-entry repair only matches rows with the legacy wording AND a same-amount original within 3 minutes."
      ],
      "anchors": [
        {"file": "lib/features/customer/offline/controllers/customer_transaction_offline_controller.dart", "contains": "findDuplicateBillingEntries"},
        {"file": "lib/features/customer/presentation/pages/customer_transactions_page.dart", "contains": "_canReceivePayment"},
        {"file": "lib/features/customer/presentation/pages/customer_transactions_page.dart", "contains": "_BillAmountsStrip"},
        {"file": "lib/features/customer/presentation/pages/customer_transactions_page.dart", "contains": "_removeDuplicateEntries"},
        {"file": "lib/features/customer/presentation/pages/customer_transactions_page.dart", "contains": "Cannot exceed pending"}
      ],
      "forbidden": [
        {"file": "lib/features/customer/presentation/pages/customer_transactions_page.dart", "contains": ".receivePayment(", "why": "double-writes the ledger"},
        {"file": "lib/features/customer/presentation/pages/customer_details_page.dart", "contains": "transactionService.receivePayment(", "why": "double-writes the ledger"}
      ],
      "tests": ["test/regression/ledger_duplicates_test.dart"]
    },
