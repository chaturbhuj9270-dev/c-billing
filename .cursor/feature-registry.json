    {
      "id": "firestore-rules",
      "name": "Firestore security rules for every synced collection",
      "files": ["firestore.rules"],
      "invariants": [
        "Each per-user collection the app reads or writes has a match block with owner + active-subscription access. Missing block = silent permission-denied and data that never syncs.",
        "After editing rules the user must deploy them: firebase deploy --only firestore:rules."
      ],
      "anchors": [
        {"file": "firestore.rules", "contains": "match /customers/"},
        {"file": "firestore.rules", "contains": "match /customer_transactions/"},
        {"file": "firestore.rules", "contains": "match /bills/"},
        {"file": "firestore.rules", "contains": "match /eventOrders/"},
        {"file": "firestore.rules", "contains": "match /expenses/"},
