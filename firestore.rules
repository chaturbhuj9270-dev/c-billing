rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Employee membership via custom claim or profile doc.
    function isEmployeeOf(userId) {
      return isSignedIn()
        && (
          request.auth.token.tenantOwnerId == userId
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantOwnerId == userId
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false
          )
        );
    }

    function isOwnerOrMember(userId) {
      return isOwner(userId) || isEmployeeOf(userId);
    }

    // Clients must not self-activate / extend paid subscription fields.
    // One-time free-trial start is allowed separately via startingFreeTrialOnly().
    function subscriptionFieldsUnchanged() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          'subscriptionDate',
          'lastSubscriptionUpdate',
          'lastSubscriptionOrderId',
          'subscriptionStatus',
          'subscriptionProvider',
          'trialStartedAt'
        ]);
    }

    // Allow existing unpaid accounts to receive trialStartedAt exactly once.
    function startingFreeTrialOnly() {
      let wasUnpaid = !('subscriptionDate' in resource.data)
        || resource.data.subscriptionDate == null;
      let hadNoTrial = !('trialStartedAt' in resource.data)
        || !(resource.data.trialStartedAt is timestamp);
      let staysUnpaid = !('subscriptionDate' in request.resource.data)
        || request.resource.data.subscriptionDate == null;
      let setsTrial = request.resource.data.trialStartedAt is timestamp
        && request.resource.data.subscriptionStatus == 'trial';
      let onlyTrialKeys = request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(['trialStartedAt', 'subscriptionStatus']);
      return wasUnpaid && hadNoTrial && staysUnpaid && setsTrial && onlyTrialKeys;
    }

    // New shop owners may start inactive or on a 30-day free trial (no paid date).
    function creatingInactiveSubscription() {
      let noPaid = (!('subscriptionDate' in request.resource.data)
          || request.resource.data.subscriptionDate == null);
      let statusOk = (!('subscriptionStatus' in request.resource.data)
          || request.resource.data.subscriptionStatus == 'inactive'
          || request.resource.data.subscriptionStatus == 'trial');
      return noPaid && statusOk;
    }

    function isUnpaid(data) {
      return !('subscriptionDate' in data) || data.subscriptionDate == null;
    }

    // Paid year OR free trial (trialStartedAt / createdAt / subscriptionStatus=trial).
    function hasActiveSubscription(userId) {
      let data = get(/databases/$(database)/documents/users/$(userId)).data;
      let paidActive = data.subscriptionDate is timestamp
        && request.time < data.subscriptionDate + duration.value(365, 'd');
      let trialByField = data.trialStartedAt is timestamp
        && request.time < data.trialStartedAt + duration.value(30, 'd');
      let trialByCreated = isUnpaid(data)
        && data.createdAt is timestamp
        && request.time < data.createdAt + duration.value(30, 'd');
      // Explicit trial flag with no paid date and no usable timestamps yet
      // (first moments after signup before serverTimestamp resolves).
      let trialByStatus = isUnpaid(data)
        && data.subscriptionStatus == 'trial'
        && !(data.trialStartedAt is timestamp)
        && !(data.createdAt is timestamp);
      return paidActive || trialByField || trialByCreated || trialByStatus;
    }

    // Employee profile docs: owner create/update via Admin SDK preferred;
    // employees may read their own profile; owners may not invent subscription on employee docs.
    match /users/{userId} {
      allow read: if isOwner(userId) || isEmployeeOf(userId)
        || (isSignedIn() && request.auth.uid == userId);

      // Owner signup OR admin creating an employee profile under their shop.
      allow create: if (isOwner(userId) && creatingInactiveSubscription())
        || (
          isSignedIn()
          && request.resource.data.role == 'employee'
          && request.resource.data.tenantOwnerId == request.auth.uid
          && !('subscriptionDate' in request.resource.data)
        );

      allow update: if (isOwner(userId) && (
            subscriptionFieldsUnchanged() || startingFreeTrialOnly()
          ))
        || (
          isSignedIn()
          && request.auth.uid == userId
          && startingFreeTrialOnly()
        )
        || (
          isSignedIn()
          && resource.data.role == 'employee'
          && resource.data.tenantOwnerId == request.auth.uid
          && request.resource.data.role == 'employee'
          && request.resource.data.tenantOwnerId == resource.data.tenantOwnerId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['subscriptionDate', 'subscriptionStatus', 'subscriptionProvider', 'trialStartedAt'])
        );

      allow delete: if isOwner(userId)
        || (
          isSignedIn()
          && resource.data.role == 'employee'
          && resource.data.tenantOwnerId == request.auth.uid
        );

      match /subscription_payments/{paymentId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Employee roster - members can read (token lookup on bills);
      // owners full write; members may only increment points.
      match /employees/{employeeId} {
        allow read: if isOwnerOrMember(userId);
        allow create, delete: if isOwner(userId) && hasActiveSubscription(userId);
        allow update: if (isOwner(userId) && hasActiveSubscription(userId))
          || (
            isOwnerOrMember(userId)
            && hasActiveSubscription(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['points', 'updatedAt'])
          );
      }

      match /customers/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /customer_transactions/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /suppliers/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /companies/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /products/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /stock/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /stockLedger/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /purchases/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /purchaseBatches/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /purchaseReturns/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /bills/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /invoices/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /eventOrders/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /expenses/{document=**} {
        allow read, write: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
      }
      match /shop_details/{document=**} {
        allow read: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
        allow write: if isOwner(userId) && hasActiveSubscription(userId);
      }
      match /settings/{document=**} {
        allow read: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
        allow write: if isOwner(userId) && hasActiveSubscription(userId);
      }
      match /product_settings/{document=**} {
        allow read: if isOwnerOrMember(userId) && hasActiveSubscription(userId);
        allow write: if isOwner(userId) && hasActiveSubscription(userId);
      }
      match /profile/{document=**} {
        allow read, write: if isOwner(userId) && hasActiveSubscription(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
