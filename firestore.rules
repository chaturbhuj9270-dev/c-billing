rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      
      // User's customers subcollection
      match /customers/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's suppliers subcollection
      match /suppliers/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's companies subcollection
      match /companies/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's products subcollection (for inventory management)
      match /products/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's stock subcollection (for inventory tracking)
      match /stock/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's purchases subcollection (for purchase orders)
      match /purchases/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's bills subcollection (for sales billing)
      match /bills/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's invoices subcollection
      match /invoices/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's customer transactions
      match /customer_transactions/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's event orders
      match /eventOrders/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }

      // User's profile document
      match /profile/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's shop details
      match /shop_details/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }

      // User's menu items subcollection (hotel menu management)
      match /menuItems/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // User's hotel sub-users subcollection
      match /hotelSubUsers/{subUserId} {
        // Admin can read/write their own sub-users
        allow read, write: if request.auth.uid == userId;
        // Sub-user can read their own record (for cached lookups)
        allow read: if request.auth != null
                     && resource.data.firebaseUid == request.auth.uid;
      }

      // FCM device tokens for hotel order notifications (one doc per auth UID)
      match /hotelPushTokens/{tokenHolderUid} {
        allow read: if request.auth.uid == userId;
        allow create, update: if request.auth.uid == userId
          || (request.auth.uid == tokenHolderUid
              && exists(/databases/$(database)/documents/staffMapping/$(tokenHolderUid))
              && get(/databases/$(database)/documents/staffMapping/$(tokenHolderUid)).data.adminUid == userId);
        allow delete: if request.auth.uid == userId
          || request.auth.uid == tokenHolderUid;
      }
    }
    
    // Staff UID mapping: staff can read their own mapping; any authenticated
    // user can create (admin writes this during staff creation).
    match /staffMapping/{staffUid} {
      allow read: if request.auth.uid == staffUid;
      allow write: if request.auth != null;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
