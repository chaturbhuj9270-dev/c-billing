# Copy to functions/.env before deploy (do not commit real secrets)
CASHFREE_ENV=SANDBOX

# Optional SMTP for 2-step login OTP emails (otherwise use Trigger Email extension on `mail`)
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=C-Billing <your@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
