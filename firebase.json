{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "cbilling",
      "public": "hosting/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        { "source": "/privacy", "destination": "/privacy.html" },
        { "source": "/terms", "destination": "/terms.html" },
        { "source": "/delete-account", "destination": "/delete-account.html" }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=3600"
            }
          ]
        }
      ]
    },
    {
      "site": "c-billing-4744a",
      "public": "hosting/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        { "source": "/privacy", "destination": "/privacy.html" },
        { "source": "/terms", "destination": "/terms.html" },
        { "source": "/delete-account", "destination": "/delete-account.html" }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=3600"
            }
          ]
        }
      ]
    }
  ]
}
